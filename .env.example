# EngBuddy Environment Configuration (.env.example)
# Copy to .env for local FastAPI / Celery / Docker Compose development.
# Do NOT commit real secrets to version control.

# --- Gemini AI Configuration ---
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# --- FastAPI Backend & Database ---
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
POSTGRES_DSN=postgresql+asyncpg://engbuddy:engbuddy_dev_pass@localhost:5432/engbuddy
REDIS_URL=redis://localhost:6379/0

# --- Security & Token Encryption (32-byte URL-safe base64 key) ---
JWT_SECRET_KEY=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32
OAUTH_TOKEN_ENCRYPTION_KEY=CHANGE_ME_32_BYTE_FERNET_KEY_BASE64

# --- Object Storage (S3 / Cloudflare R2 / MinIO) ---
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_NAME=engbuddy-vault
S3_REGION=auto

# --- Google OAuth 2.0 (Least-Privilege Read-Only Scopes for Classroom & Gmail) ---
GOOGLE_OAUTH_CLIENT_ID=YOUR_GOOGLE_OAUTH_CLIENT_ID.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=YOUR_GOOGLE_OAUTH_CLIENT_SECRET
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/integrations/google/callback

# --- Optional WhatsApp Business Cloud API Forwarder Webhook (Feature Flagged) ---
ENABLE_WHATSAPP_CLOUD_WEBHOOK=false
WHATSAPP_VERIFY_TOKEN=YOUR_WHATSAPP_WEBHOOK_VERIFY_TOKEN
WHATSAPP_ACCESS_TOKEN=YOUR_WHATSAPP_CLOUD_API_TOKEN
